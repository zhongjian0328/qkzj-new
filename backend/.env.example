# =============================================================================
# 禽康智检后端环境变量模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# =============================================================================

# 服务器配置
PORT=3000
NODE_ENV=development

# MongoDB数据库配置
# 开发环境：本地 MongoDB；生产环境：MongoDB Atlas 连接字符串
MONGODB_URI=mongodb://localhost:27017/qinkangzhijian

# JWT配置
# 生产环境必须替换为强随机值（至少 48 字节）：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=7d

# 火山引擎 豆包2.0 API配置（OpenAI-compatible）
# 控制台：https://console.volcengine.com/ark
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-1-pro-260628

# 图片存储配置
IMAGE_STORAGE_TYPE=local  # local 或 s3
LOCAL_IMAGE_PATH=./uploads
# S3 配置（IMAGE_STORAGE_TYPE=s3 时使用）
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=your_s3_bucket
S3_REGION=your_s3_region

# CORS配置
# 生产环境填入前端实际域名，逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
