{
  "expo": {
    "name": "禽康智检",
    "slug": "qinkangzhijian",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_downloaded.png",
    "userInterfaceStyle": "light",
    
    "splash": {
      "image": "./assets/images/icon_downloaded.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "animation": {
        "fade": true
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qinkangzhijian.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon_downloaded.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.qinkangzhijian.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "允许应用访问您的照片库以选择诊断图像",
          "cameraPermission": "允许应用访问您的相机以拍摄诊断图像"
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "44f33fb6-f70d-4f10-8f61-28523e8bed84"
      },
      "apiUrl": "http://localhost:3000/api"
    },
    
  }
}
